# 로컬 기본값입니다. 복사해서 .env 로 두면 됩니다. (cp .env.example .env)

# PDF 읽기(M2)에 쓰는 Claude API 키. 없어도 앱과 테스트는 돕니다.
# 키가 없으면 올린 PDF는 녹화해 둔 응답이 있을 때만 읽을 수 있습니다.
ANTHROPIC_API_KEY=

# 로컬은 내장형 Postgres(PGlite) 폴더. 배포에서는 postgres://... 주소 (Vercel에 연결한 Postgres가 넣어 줍니다).
DATABASE_URL=pglite://./data/pg

# 올린 PDF를 두는 폴더. 파일 시스템을 쓸 수 없는 배포 환경에서는 STORAGE_DRIVER=db 로 데이터베이스에 둡니다.
STORAGE_DIR=./data/uploads

# local: 고정 사용자 1명 (로컬 개발).
# anonymous: 로그인 없이 브라우저마다 익명 계정 하나. 공개 배포에서 씁니다. AUTH_SECRET(쿠키 서명용 긴 무작위 문자열)이 필요합니다.
# 계정 로그인(카카오, 구글, 애플)은 이후에 붙입니다.
AUTH_MODE=local
# AUTH_SECRET=

# mock: 가짜 결제 스위치. 결제 제공자는 M4에서 정합니다.
BILLING_PROVIDER=mock

# --- 선택 ---
# 변환 한 번마다 LLM 비용이 듭니다. 공개 배포에서 API 키를 넣을 때는 상한을 함께 둡니다.
# MAX_CONVERSIONS_PER_DAY=20     # 하루에 읽을 수 있는 도안 수 (전체)
# MAX_CONVERSIONS_PER_USER=3     # 한 사용자가 읽을 수 있는 도안 수
# MAX_PDF_MB=20                  # 올릴 수 있는 PDF 크기. Vercel에서는 기본 4MB (요청 본문 한도 4.5MB)
# READER_MODEL=claude-opus-5-5   # 읽기에 쓰는 모델
# READER_MAX_FEEDBACK=2          # 검산이 어긋났을 때 LLM에 되돌리는 최대 횟수
